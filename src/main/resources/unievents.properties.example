# UniEvents — database connection settings
# Copy this file to unievents.properties (same directory is on the classpath,
# or export the equivalent environment variables instead).
#
# Direct connection (Supabase Dashboard → Project Settings → Database):
#   jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres
# Session pooler (recommended when the direct port 5432 is blocked):
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
db.url=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
db.user=postgres
db.password=YOUR_DATABASE_PASSWORD
